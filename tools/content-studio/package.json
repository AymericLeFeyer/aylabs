{
  "name": "aylabs-content-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Outil local de gestion du contenu AyLabs (vidéos & produits)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "preview": "vite preview",
    "lint": "eslint .",
    "check": "esbuild scripts/roundtrip-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/roundtrip.mjs --log-level=error && node node_modules/.cache/roundtrip.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/server.mjs --log-level=error",
    "start": "node dist-server/server.mjs dist"
  },
  "dependencies": {
    "lucide-react": "^0.527.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "esbuild": "^0.21.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
