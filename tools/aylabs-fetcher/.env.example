# Obligatoire : clé de l'API YouTube Data v3.
YOUTUBE_API_KEY=
# Obligatoire hors --dry-run : jeton fine-grained limité au dépôt, Contents en
# lecture/écriture. Pas le GITHUB_TOKEN d'Actions : ses pushs ne déclenchent pas
# le déploiement.
FETCHER_GITHUB_TOKEN=
# Facultatif : sans lui, le résultat n'apparaît que dans les logs.
DISCORD_WEBHOOK_URL=

# Valeurs par défaut :
# YOUTUBE_CHANNEL_ID=UClCAe7FyrIwpkt9H56XRndA
# GITHUB_REPO=AymericLeFeyer/aylabs
# GITHUB_BRANCH=main
